---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { Distribution } from "../../components/Distribution";
import { optimizeImagePath } from "../../utils/images";

const slugify = (await import("slugify")).default;

const name = Astro.params.name;
const dist = name
  ? (await getCollection("distributions")).find(
      entry =>
        slugify((entry.data as any).name, {
          lower: true,
          remove: /[^\w\s$*_+~.()'"!\-@]+/g,
        }) === name,
    )?.data
  : undefined;

if (!dist) return Astro.rewrite("/404");

const distData = dist as any;
const optimizedIcon = await optimizeImagePath(distData.icon);
const optimizedDist = { ...distData, icon: optimizedIcon };
---

<!-- Google tag (gtag.js) -->
<script async src="https://www.googletagmanager.com/gtag/js?id=G-E3BVDYNVRP"
></script>
<script>
  window.dataLayer = window.dataLayer || [];
  function gtag() {
    dataLayer.push(arguments);
  }
  gtag("js", new Date());

  gtag("config", "G-E3BVDYNVRP");
</script>

<BaseLayout
  title={"Downloads for " + distData.name}
  breadcrumbs={distData.name + " | Downloads"}
>
  <Distribution dist={optimizedDist} client:load />
</BaseLayout>
