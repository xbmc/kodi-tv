---
import { getCollection } from "astro:content";
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import AddonAuthorLayout from "../../../../components/AddonAuthorLayout";

const slug = Astro.params.slug;
const author = slug
  ? (await getCollection("omegaAuthors")).find(
      entry => (entry.data as any).slug === slug,
    )?.data
  : undefined;

if (!author) return Astro.rewrite("/404");

const authorData = author as any;
---

<BaseLayout
  title="Omega Author Details"
  breadcrumbs={authorData.name + " | Author | Omega | Addons"}
>
  <AddonAuthorLayout repo="Omega" data={{ author: authorData }} />
</BaseLayout>
