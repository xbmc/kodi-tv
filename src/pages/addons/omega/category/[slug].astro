---
import { getCollection } from "astro:content";
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import AddonCategoryLayout from "../../../../components/AddonCategoryLayout";

const slug = Astro.params.slug;
const category = slug
  ? (await getCollection("omegaCategories")).find(
      entry => (entry.data as any).slug === slug,
    )?.data
  : undefined;

if (!category) return Astro.redirect("/404");

const categoryData = category as any;
---

<BaseLayout
  title="Omega Add-on Category List"
  breadcrumbs={categoryData.name + " | Category | Omega | Addons"}
>
  <AddonCategoryLayout repo="Omega" data={{ category: categoryData }} />
</BaseLayout>
