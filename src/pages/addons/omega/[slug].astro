---
import { getCollection } from "astro:content";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import AddonLayout from "../../../components/AddonLayout";

const slug = Astro.params.slug;
const addon = slug
  ? (await getCollection("omegaAddons")).find(
      entry => (entry.data as any).slug === slug,
    )?.data
  : undefined;

if (!addon) return Astro.redirect("/404");

const addonData = addon as any;

let breadcrumbs = addonData.name + " | Omega | Addons";
let description = addonData.snippet || "";
let image = addonData.screenshots?.[0]?.localpath || undefined;
---

<BaseLayout
  title="Omega Add-on Details"
  breadcrumbs={breadcrumbs}
  description={description}
  image={image}
>
  <AddonLayout repo="Omega" data={{ addon: addonData }} />
</BaseLayout>
